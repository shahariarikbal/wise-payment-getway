{
    "name": "devikbal/laravel-wise-payment",
    "description": "Laravel Wise (TransferWise) payment gateway integration package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Shahariar Ikbal",
            "email": "shahariar.ikbal86@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Devikbal\\WisePayment\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devikbal\\WisePayment\\WiseServiceProvider"
            ],
            "aliases": {
                "Wise": "Devikbal\\WisePayment\\Facades\\Wise"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
